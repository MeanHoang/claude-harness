#!/usr/bin/env bash
# PreToolUse(Bash): DENY `git commit` / `git push` unless the user's MOST RECENT prompt allows
# it explicitly.
#
# Why: the rule "commit only when the user says OK" used to live in prose inside the ship skill.
# A child session running `--dangerously-skip-permissions` has nothing holding it to that. On
# 2026-08-05 four commits turned up on a branch, none of them approved.
#
# Consent must come from a HUMAN: the hook reads the last user turn in that session's own
# transcript. A child session cannot fabricate a user message, so it cannot work around this by
# editing progress.md.
#
# Ratchet trace: the git-workflow feedback memory ("YOU JUST COMMITTED?!", 2026-06-29) plus the
# 2026-08-05 report.

set -uo pipefail

input=$(cat)
cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null)
[ -n "$cmd" ] || exit 0

# Guard only commands that ACTUALLY create a commit or push to a remote.
# `git` must be at the start of the string or straight after ; & | ( — not after arbitrary
# whitespace. Looser than that and a command merely *mentioning* "git commit" in text is blocked.
printf '%s' "$cmd" | grep -qE '(^|[;&|(])[[:space:]]*git[[:space:]]+(commit|push)([[:space:]]|$)' || exit 0

deny() {
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$1"
  exit 0
}

transcript=$(printf '%s' "$input" | jq -r '.transcript_path // empty' 2>/dev/null)
[ -n "$transcript" ] && [ -f "$transcript" ] \
  || deny "STOP: cannot read the transcript to verify the user consented to a commit. Ask, then commit later."

# The last user turn: prefer a REAL user message, fall back to last-prompt.
#
# The original order was the other way round, and the hook lagged by EXACTLY ONE TURN: the
# `last-prompt` record is only written to the transcript after that turn finishes, so when the
# hook read it, it still held the PREVIOUS turn's prompt. On 2026-08-06 a plain "ok commit and
# push" was blocked and needed a second turn to get through. Worse than annoying: consent from an
# earlier turn drifts into a later one, which is the exact thing this hook exists to prevent.
#
# A user message does not lag, but two kinds of entry that no human typed have to be filtered
# out (they are why the old version reached for last-prompt in the first place): system reminders
# (`<...`) and background-task notifications (`[SYSTEM NOTIFICATION...`). Both sit under the
# "user" type.
last=$(jq -Rc '
  fromjson? // empty | select(.type == "user") | .message.content
  | if type == "array" then (.[0] | select(.type == "text") | .text)
    elif type == "string" then . else empty end
  | select(type == "string" and length > 0
           and (startswith("<") | not)
           and (startswith("[SYSTEM NOTIFICATION") | not)) | @json
' "$transcript" 2>/dev/null | tail -1)
[ -n "$last" ] || last=$(jq -Rc '
  fromjson? // empty | select(.type == "last-prompt") | .lastPrompt
  | select(type == "string" and length > 0) | @json
' "$transcript" 2>/dev/null | tail -1)
[ -n "$last" ] || deny "STOP: no user turn found in this session. Not committing on my own."

msg=$(printf '%s' "$last" | jq -r 'fromjson' 2>/dev/null \
  | perl -CSD -MUnicode::Normalize -ne 'print NFD(lc($_) =~ s/\x{111}/d/gr) =~ s/\p{M}//gr' 2>/dev/null)
[ -n "$msg" ] || deny "STOP: could not read the user's last prompt. Not committing on my own."

# A negation next to "commit"/"push". Check this FIRST, or "do not commit" would pass.
if printf '%s' "$msg" | grep -qE '(dung|khong|ko|chua|khoan|dinh)[[:space:]]+(tu[[:space:]]+)?(commit|push)'; then
  deny "STOP: the user's last prompt says NOT to commit/push. Stop, report, and wait."
fi

# Explicit consent.
if printf '%s' "$msg" | grep -qE '(^|[^a-z])(commit|push)([^a-z]|$)|/commit|/push|day len|len staging'; then
  exit 0
fi

deny "STOP: the user has not consented to a commit/push in THIS turn. Consent counts only for the turn it was given in and never carries into a later phase. Report, end with \\\"OK means I commit this phase.\\\" and WAIT."
