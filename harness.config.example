# harness.config — fill these in after pasting the harness into a project.
#
# Some skills reference things only your project knows: where its packages live, which
# cloud projects it deploys to, which stores you test against. Those were stripped before
# publishing and replaced by {{VARS}}. Copy this file to `harness.config`, fill in what
# applies, then run:
#
#   ./fill-vars.sh /path/to/project harness.config
#
# Anything you leave out stays as a visible {{VAR}} and gets reported, so nothing is
# silently blanked. Delete the lines that make no sense for your stack.
#
# `harness.config` is gitignored. Never commit the filled-in version.

# ── Where things live ──────────────────────────────────────────────────────────
PROJECT_ROOT=/Users/you/Projects/my-app

# Monorepo package paths, used by the review/merge skills. Single-package repo? Drop them.
PKG_BACKEND=packages/server              # server code
PKG_ADMIN=packages/admin                 # admin/dashboard frontend

# ── Git ────────────────────────────────────────────────────────────────────────
GIT_REMOTE_HOST=git.example.com/org/repo

# ── Cloud projects ─────────────────────────────────────────────────────────────
FIREBASE_STAGING=my-app-staging          # staging; skills append -N for numbered stagings

# ── Test stores / tenants ──────────────────────────────────────────────────────
DEV_STORE=my-dev-store.example.com
DEV_STORE_ALT=my-second-dev-store.example.com
STAGING_STORE=my-staging-store.example.com
STAGING_STORE_ALT=my-other-staging-store.example.com

APP_HANDLE=my-app                        # app handle in the platform admin URL
STAGING_HANDLE=my-app-staging

# Password on the storefront password page of every dev/staging store.
STOREFRONT_PASSWORD=1

# ── Team channels ──────────────────────────────────────────────────────────────
DEV_CHANNEL=dev                          # chat channel the catch-up skill reads

# ── Test identities ────────────────────────────────────────────────────────────
WORK_EMAIL=you@example.com

# The mail-reading step also needs two real environment variables at run time.
# Keep them in your shell or .env, NEVER here:
#   TEST_MAIL_USER
#   TEST_MAIL_APP_PASSWORD
#
# ⚠️ That app password can read a real mailbox. Scope it to one-time-code lookups only.
